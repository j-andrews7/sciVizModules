{
  "sandbox": {
    "enabled": false
  },
  "permission": {
    "edit": {
      "*.R": "allow",
      "*/DESCRIPTION": "allow",
      "*.Rmd": "allow"
    },
    "executeCode": {
      "*": "allow"
    },
    "bash": {
      "R *": "allow",
      "head *": "allow",
      "echo *": "allow",
      "ls *": "allow",
      "Rscript *": "allow",
      "*": "allow"
    },
    "external_directory": {
      "/tmp/*": "allow",
      "/Library/Frameworks/R.framework/Versions/4.6/Resources/library/VizModules/doc/*": "allow"
    },
    "read": {
      "*.txt": "allow",
      "*": "allow"
    }
  }
}