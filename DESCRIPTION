Package: sciVizModules
Title: Flexible, scientific based interactive plotting VizModules
Version: 0.99.0.9000
Authors@R: 
    c(person(given = "Jared", family = "Andrews", email = "jared.andrews07@gmail.com", role = c("aut", "cre"),
